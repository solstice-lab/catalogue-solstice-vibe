# Modèle des variables d'environnement. Copier en .env.local et remplacer
# chaque valeur factice ; en prod, les déclarer chez l'hébergeur. Ne jamais
# écrire ici une vraie URL ni un vrai mot de passe : ce fichier est suivi.

# Base Postgres : en local la base _dev (jamais celle des tests), en prod l'URL de l'hébergeur.
DATABASE_URL=postgresql://postgres@localhost:5433/mon_appli_dev

# Chiffrement de la connexion (src/lib/db/client.ts). « disable » pour un
# Postgres local sans SSL ; en production vers un hôte distant, l'appli le
# refuse (un .env.local recopié chez l'hébergeur ferait circuler le mot de
# passe en clair) : ne jamais le déclarer chez l'hébergeur. Vide : chiffré,
# certificat vérifié par les CA que Node reconnaît, ou par le CA dont
# PGSSLROOTCERT donne le chemin (fichier PEM). « no-verify » : chiffré sans vérifier, pour un hébergeur dont le
# certificat ne se vérifie pas, en connaissance de cause. Pas de sslmode dans
# DATABASE_URL : il passerait avant ces réglages.
PGSSLMODE=disable
# PGSSLROOTCERT=

# Commit en ligne, renvoyé par /sante pour que la CI vérifie son déploiement.
# Posé au démarrage par la brique déploiement, jamais déclaré à la main ; sans
# elle, le déclarer chez l'hébergeur depuis sa propre variable. Absent, /sante
# répond « inconnu ».
# COMMIT_DEPLOYE=

# Adresse publique du site, en https et sans chemin (https://www.exemple.fr) :
# adresse canonique, aperçu au partage, sitemap (src/lib/referencement.ts). À
# déclarer sur le service de production SEULEMENT : absente, le site reste
# fermé aux moteurs de recherche, ce que veut une recette ou le local.
# URL_PUBLIQUE=

# L'en-tête HTTP où le proxy de l'hébergeur pose l'adresse IP du visiteur
# (src/lib/adresse-ip.ts), pour les limites par adresse. Vide en local
# (l'adresse vaut « local ») ; chez l'hébergeur, celui de son proxy, jamais un
# autre : un en-tête qu'il ne pose pas, le visiteur l'écrit. Obligatoire en
# production avec la brique comptes : sans elle, l'appli refuse de démarrer,
# /sante comprise (Render : cf-connecting-ip). Avec le seul formulaire de
# contact, vide en production, sa limite par adresse ne s'applique pas.
IP_EN_TETE_CLIENT=

# Brique comptes (src/briques/comptes/).
# Signe le cookie de session et sert de clé aux empreintes des codes de
# connexion : 32 caractères au moins, aléatoires, propres à
# chaque appli et à chaque environnement. Le générer, sous PowerShell :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vide, toute connexion échoue en le disant. Chez l'hébergeur, render.yaml le
# fait générer : jamais écrit ici.
AUTH_SECRET=
# L'adresse du premier admin : elle entre avec ROLE_ADMIN (src/config/acces.ts)
# tant qu'aucun compte n'a jamais eu ce rôle : elle vaut pour le premier
# démarrage. Les autres entrées se déclarent dans src/config/comptes.ts.
COMPTES_PREMIER_ADMIN=
# Connexion avec Google (« google » dans METHODES, src/config/comptes.ts) :
# l'ID client OAuth et son secret, créés dans la console Google Cloud du
# client (procédure dans le README de la brique comptes). Vides, la carte
# Google de /connexion dit ce qui manque. Le secret ne s'écrit jamais ici.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion avec Microsoft (« microsoft » dans METHODES) : l'ID d'application
# (client), son secret et l'ID de l'annuaire (tenant) du client, un GUID,
# relevés dans le portail Azure (procédure dans le README de la brique
# comptes). MICROSOFT_TENANT_ID ne sert qu'avec ANNUAIRES_MICROSOFT =
# "un-seul" (src/config/comptes.ts), le défaut. Vides, la carte Microsoft de
# /connexion dit ce qui manque. Le secret ne s'écrit jamais ici.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Fin de la brique comptes.

# Brique mails (src/briques/mails/).
# « console » en local (le mail s'affiche, rien ne part) ; « resend » chez
# l'hébergeur. Vide ou « console » en production : l'envoi échoue.
MAILS_FOURNISSEUR=console
# Une adresse du domaine vérifié chez Resend.
MAILS_EXPEDITEUR="Mon appli <ne-pas-repondre@exemple.fr>"
# Secret, laissé vide ici : la vraie clé se déclare chez l'hébergeur seulement.
RESEND_API_KEY=
# Fin de la brique mails.

# Brique notifications (src/briques/notifications/).
# Secret partagé avec la tâche planifiée qui appelle la route. Vide : la route
# refuse tout. La vraie valeur se déclare chez l'hébergeur et dans les secrets
# de la tâche, jamais ici.
NOTIFICATIONS_SECRET=
# Les seules adresses permises en mode essai, séparées par des virgules. Vide :
# le mode essai refuse tout.
NOTIFICATIONS_ADRESSES_ESSAI=
# Fin de la brique notifications.

# Brique contact (src/briques/contact/).
# L'adresse qui reçoit les messages du formulaire de contact. Sans elle, le
# formulaire échoue au lieu d'envoyer nulle part.
CONTACT_DESTINATAIRE="contact@exemple.fr"
# Fin de la brique contact.
