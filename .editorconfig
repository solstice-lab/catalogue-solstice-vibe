# Ce que l'éditeur applique dès la frappe, avant Prettier : mêmes fins de
# ligne et même indentation sous Windows, macOS et Linux.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Deux espaces en fin de ligne y forcent un retour à la ligne.
[*.md]
trim_trailing_whitespace = false
